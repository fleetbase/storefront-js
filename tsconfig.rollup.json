        "noEmit": false,
        "declaration": false,
        "emitDeclarationOnly": false,
        "sourceMap": true,
        "module": "ESNext",
        "moduleResolution": "Bundler"
    },
    "include": ["src/**/*.ts"],
    "exclude": ["tests", "types", "dist", "coverage"]
}
